# ShadowGuard Robot - WITH GPS ADDED
Robot {
  translation 0 -4 0.08
  rotation 0 0 1 1.5708
  children [
    # Body
    Shape {
      appearance PBRAppearance {
        baseColor 0.1 0.1 0.15
        roughness 0.3
        metalness 0.7
      }
      geometry Cylinder { height 0.15 radius 0.15 }
    }
    
    # Security Badge on top
    Transform {
      translation 0 0 0.08
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0 0.3 0.8
            roughness 0.2
            metalness 0.9
            emissiveColor 0 0.2 0.5
          }
          geometry Cylinder { height 0.01 radius 0.08 }
        }
      ]
    }
    
    # Camera mount
    Transform {
      translation 0 0 0.1
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 0.4
            metalness 0.5
          }
          geometry Box { size 0.08 0.06 0.05 }
        }
      ]
    }
    
    # RGB Camera
    Camera {
      translation 0.12 0 0.08
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.1 0.1
            roughness 0.2
            metalness 0.8
          }
          geometry Box { size 0.02 0.03 0.02 }
        }
      ]
      name "rgb_camera"
      fieldOfView 1.2
      width 640
      height 480
      recognition Recognition {
        maxObjects 10
        maxRange 15
      }
    }
    
    # LiDAR
    Lidar {
      translation 0 0 0.12
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.3
            roughness 0.3
            metalness 0.6
          }
          geometry Cylinder { height 0.04 radius 0.03 }
        }
      ]
      name "lidar"
      horizontalResolution 512
      fieldOfView 6.28319
      numberOfLayers 1
      near 0.1
      minRange 0.1
      maxRange 10
    }
    
    # GPS - ADDED FOR MAPPING
    GPS {
      translation 0 0 0.08
      name "gps"
    }
    
    # Left Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        axis 0 1 0
        anchor 0 0.12 -0.03
      }
      device [
        RotationalMotor {
          name "left_motor"
          maxVelocity 10
          maxTorque 10
        }
        PositionSensor {
          name "left_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0.12 -0.03
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.5
              metalness 0.3
            }
            geometry Cylinder { height 0.03 radius 0.05 }
          }
        ]
        name "left_wheel"
        boundingObject Cylinder { height 0.03 radius 0.05 }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    
    # Right Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        axis 0 1 0
        anchor 0 -0.12 -0.03
      }
      device [
        RotationalMotor {
          name "right_motor"
          maxVelocity 10
          maxTorque 10
        }
        PositionSensor {
          name "right_sensor"
        }
      ]
      endPoint Solid {
        translation 0 -0.12 -0.03
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.1 0.1 0.1
              roughness 0.5
              metalness 0.3
            }
            geometry Cylinder { height 0.03 radius 0.05 }
          }
        ]
        name "right_wheel"
        boundingObject Cylinder { height 0.03 radius 0.05 }
        physics Physics {
          density -1
          mass 0.05
        }
      }
    }
    
    # Front Caster Wheel
    Solid {
      translation 0.08 0 -0.055
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.3 0.3 0.3
            roughness 0.4
            metalness 0.2
          }
          geometry Sphere { radius 0.025 }
        }
      ]
      name "caster_front"
      boundingObject Sphere { radius 0.025 }
      physics Physics {
        density -1
        mass 0.005
      }
    }
    
    # Camera Display
    Display {
      translation 0 0 0.2
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0 0 0 }
          geometry Box { size 0.001 0.001 0.001 }
        }
      ]
      name "camera_display"
      width 320
      height 240
    }
    
    # Map Display
    Display {
      translation 0 0 0.25
      rotation 0 0 1 0
      children [
        Shape {
          appearance PBRAppearance { baseColor 0 0 0 }
          geometry Box { size 0.001 0.001 0.001 }
        }
      ]
      name "map_display"
      width 400
      height 400
    }
    Compass {
      translation 0 0 0.08
      name "compass"
    }
    Emitter {
      name "emitter"
      range 50
      channel 1
    }
  ]
  name "ShadowGuard"
  boundingObject Cylinder { height 0.15 radius 0.15 }
  physics Physics { density -1 mass 1 }
  controller "shadowguard_controller"
  supervisor TRUE
  recognitionColors [ 0 0.3 0.8 ]
}

# INTRUDER Robot
DEF INTRUDER_ROBOT Robot {
  translation 3.5 2.5 0.08
  rotation 0 0 1 0
  children [
    # Body
    Shape {
      appearance PBRAppearance {
        baseColor 0.8 0.2 0.1
        roughness 0.6
        metalness 0.2
        emissiveColor 0.3 0.05 0
      }
      geometry Box { size 0.25 0.25 0.35 }
    }
    
    # Head/Top marker
    Transform {
      translation 0 0 0.22
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 0.3 0
            roughness 0.4
            metalness 0.3
            emissiveColor 0.5 0.1 0
          }
          geometry Sphere { radius 0.08 }
        }
      ]
    }
    
    # Warning symbol on body
    Transform {
      translation 0.13 0 0
      rotation 0 1 0 1.5708
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 1 1 0
            roughness 0.3
            metalness 0
            emissiveColor 0.3 0.3 0
          }
          geometry Cylinder { height 0.005 radius 0.06 }
        }
      ]
    }
    
    # Left Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        axis 0 1 0
        anchor -0.05 0.15 -0.125
      }
      device [
        RotationalMotor {
          name "intruder_left_motor"
          maxVelocity 8
          maxTorque 8
        }
      ]
      endPoint Solid {
        translation -0.05 0.15 -0.125
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
              roughness 0.7
              metalness 0.1
            }
            geometry Cylinder { height 0.04 radius 0.06 }
          }
        ]
        name "intruder_left_wheel"
        boundingObject Cylinder { height 0.04 radius 0.06 }
        physics Physics { density -1 mass 0.06 }
      }
    }
    
    # Right Wheel
    HingeJoint {
      jointParameters HingeJointParameters {
        position 0
        axis 0 1 0
        anchor -0.05 -0.15 -0.125
      }
      device [
        RotationalMotor {
          name "intruder_right_motor"
          maxVelocity 8
          maxTorque 8
        }
      ]
      endPoint Solid {
        translation -0.05 -0.15 -0.125
        rotation 1 0 0 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.15 0.15 0.15
              roughness 0.7
              metalness 0.1
            }
            geometry Cylinder { height 0.04 radius 0.06 }
          }
        ]
        name "intruder_right_wheel"
        boundingObject Cylinder { height 0.04 radius 0.06 }
        physics Physics { density -1 mass 0.06 }
      }
    }
    
    # Front Caster
    Solid {
      translation 0.1 0 -0.15
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.4 0.2 0.1
            roughness 0.5
            metalness 0.1
          }
          geometry Sphere { radius 0.03 }
        }
      ]
      name "intruder_caster"
      boundingObject Sphere { radius 0.03 }
      physics Physics { density -1 mass 0.015 }
    }
    Receiver {
      name "receiver"
      channel 1
    }
  ]
  name "Intruder"
  boundingObject Box { size 0.25 0.25 0.35 }
  physics Physics { density -1 mass 1.2 }
  controller "intruder_controller"
  recognitionColors [ 0.8 0.2 0.1 ]
}