#VRML_SIM R2025a utf8
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2023b/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [ "ShadowGuard Security Robot Patrol World" ]
  title "ShadowGuard House Patrol"
  basicTimeStep 16
}

Viewpoint {
  orientation -0.5 0.5 0.7 1.9
  position 2.5 -3.5 6.8
}

TexturedBackground {
}

TexturedBackgroundLight {
}

# Floor
RectangleArena {
  translation 0 0 0
  floorSize 12 10
  floorTileSize 1 1
  wallHeight 0.01
}

# Walls - Creating house structure
Solid {
  translation 0 -5 1.25
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.8
        roughness 0.5
        metalness 0
      }
      geometry Box { size 12 0.2 2.5 }
    }
  ]
  name "wall_back"
  boundingObject Box { size 12 0.2 2.5 }
}

